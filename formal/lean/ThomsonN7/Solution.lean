    simp [Finset.mem_filter, Finset.mem_Ioi, hij, hlt]
  have hm := case1_margin y hy (fun i j hij => by
    by_contra hlt
    push Not at hlt
    rcases lt_or_gt_of_ne hij with h | h
    · have := key i j h hlt
      omega
    · have := key j i h (by rw [real_inner_comm]; exact hlt)
