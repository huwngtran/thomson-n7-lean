'ThomsonN7.thomson_seven' depends on axioms: [propext, Classical.choice, Quot.sound]
'ThomsonN7.thomson_seven_unique' depends on axioms: [propext, Classical.choice, Quot.sound]
ThomsonN7.thomson_seven : ∀ x ∈ ThomsonN7.SphereConfig 7,
  ThomsonN7.coulombEnergy ThomsonN7.pentBipyramid ≤ ThomsonN7.coulombEnergy x
ThomsonN7.thomson_seven_unique : ∀ x ∈ ThomsonN7.SphereConfig 7,
  ThomsonN7.coulombEnergy x = ThomsonN7.coulombEnergy ThomsonN7.pentBipyramid →
    ∃ g σ, ∀ (i : Fin 7), x i = g (ThomsonN7.pentBipyramid (σ i))
